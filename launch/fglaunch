#!/bin/bash
# Launch a side-by-side FlightGear install with a named configuration.
#
#   fglaunch <install> [config] [extra fgfs options...]
#
# Each install lives in $FG_BASE/installs/<install>/ and contains:
#   fgfs     symlink to the AppImage to run (swap it to change builds)
#   fgdata/  FGData matching that build
#   home/    FG_HOME for that install (created on first launch)
#   aircraft/  optional extra aircraft, e.g. git clones not in that build's
#            catalog (the C172P for next)
# Scenery is shared by all installs in $FG_BASE/shared/TerraSync.
set -euo pipefail

# Resolve through any symlink (e.g. ~/flightgear/fglaunch) to find the repo checkout.
REPO="$(readlink -f "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/..")"
FG_BASE="${FG_BASE:-/mnt/nocow/doberlin/flightgear}"
CONFIGS="desktop vr"

usage() {
    echo "usage: fglaunch <install> [config] [fgfs options...]" >&2
    echo "  installs: $(ls "$FG_BASE/installs" 2>/dev/null | tr '\n' ' ')" >&2
    echo "  configs:  $CONFIGS (default: desktop)" >&2
    exit 2
}

[ $# -ge 1 ] || usage
install="$1"
shift
config="desktop"
if [ $# -ge 1 ] && [[ " $CONFIGS " == *" $1 "* ]]; then
    config="$1"
    shift
fi

dir="$FG_BASE/installs/$install"
if [ ! -x "$dir/fgfs" ] || [ ! -d "$dir/fgdata" ]; then
    echo "fglaunch: '$install' is not a complete install (need $dir/fgfs and $dir/fgdata)" >&2
    usage
fi

case "$config" in
    desktop)
        config_opts=(--disable-vr --prop:/sim/current-view/y-offset-m=0.0)
        ;;
    vr)
        export XR_RUNTIME_JSON=/var/lib/flatpak/app/io.github.wivrn.wivrn/current/active/files/share/openxr/1/openxr_wivrn.json
        config_opts=(--enable-vr --prop:/sim/current-view/y-offset-m=0.2)
        ;;
esac

# Share joystick bindings from the repo so every install uses the same
# calibration, and saving from the Joystick Configuration dialog updates the repo.
home="$dir/home"
mkdir -p "$home/Input"
joysticks="$home/Input/Joysticks"
if [ ! -e "$joysticks" ] && [ ! -L "$joysticks" ]; then
    ln -s "$REPO/config/Input/Joysticks" "$joysticks"
elif [ ! -L "$joysticks" ]; then
    echo "fglaunch: warning: $joysticks is a real directory, not the shared repo bindings" >&2
fi

aircraft_opts=()
if [ -d "$dir/aircraft" ]; then
    aircraft_opts=(--fg-aircraft="$dir/aircraft")
fi

export FG_HOME="$home"
exec "$dir/fgfs" --launcher \
    --fg-root="$dir/fgdata" \
    --terrasync-dir="$FG_BASE/shared/TerraSync" \
    --httpd=8080 \
    --addon="$REPO/addon" \
    "${aircraft_opts[@]}" \
    "${config_opts[@]}" \
    "$@"
